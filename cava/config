# Cava Audio Visualizer Configuration
# Flat style - minimal gaps

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = mono
bar_width = 1
bar_spacing = 0
bar_height = 100

[color]
theme = "noctalia"
gradient = 1
gradient_count = 4
gradient_color_1 = '#ffb4ab'
gradient_color_2 = '#f5c2e7'
gradient_color_3 = '#cba6f7'
gradient_color_4 = '#f2cdcd'

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2
