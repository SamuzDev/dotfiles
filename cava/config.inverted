# Cava Audio Visualizer Configuration
# Flat style - minimal gaps, blanco abajo / negro arriba

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = mono
bar_width = 1
bar_spacing = 0
bar_height = 100

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#FFFFFF'  ; blanco (abajo)
gradient_color_2 = '#888888'
gradient_color_3 = '#444444'
gradient_color_4 = '#000000'  ; negro (arriba)

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2