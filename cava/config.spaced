# Cava - modo 2: color plano, barras CON ESPACIO (normales)

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = mono
bar_width = 2
bar_spacing = 1
bar_height = 100

[color]
gradient = 0
foreground = '#ffffff'

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2